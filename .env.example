# Canonical URL used for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://pdfflow.app

# Optional. Base URL of a document-conversion service that implements the
# contract in src/lib/services/pdfService.ts. Leave empty and the server-side
# tools (Office conversion, OCR, protect/unlock) explain that they need one
# instead of returning a fake result.
NEXT_PUBLIC_PDF_API_URL=
